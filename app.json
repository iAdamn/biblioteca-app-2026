{
  "expo": {
    "name": "Biblioteca Aiden",
    "slug": "biblioteca-app-2026",
    "version": "1.0.0",
    "platforms": ["android", "ios"],
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "bibliotecaaiden",
    "userInterfaceStyle": "automatic",
    "ios": { "bundleIdentifier": "com.iadamn.biblioteca2026" },
    "android": {
      "package": "com.iadamn.biblioteca2026",
      "adaptiveIcon": {
        "backgroundColor": "#EEE8F8",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      }
    },
    "web": { "output": "static", "favicon": "./assets/images/favicon.png" },
    "plugins": ["expo-router", "expo-sqlite", "expo-secure-store", ["expo-image-picker", {
      "cameraPermission": "Biblioteca usa la cámara solo para fotografiar una portada.",
      "photosPermission": "Elige únicamente la foto que quieras usar como portada.",
      "microphonePermission": false
    }]],
    "experiments": { "typedRoutes": true, "reactCompiler": true }
  }
}
